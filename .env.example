APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_BASE_PATH=
APP_TIMEZONE=Asia/Jakarta
SESSION_NAME=alhasan_admin
SESSION_SECURE_COOKIE=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webalhasan
DB_USER=webalhasan_user
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Wajib berupa secret acak panjang pada produksi. Jangan commit nilai sebenarnya.
API_TOKEN_HASH_SECRET=
API_TOKEN_TTL_DAYS=30

# Modul perizinan lama `admin/admin_izin.php` sudah diarsipkan pada V2 Fase 2 dan
# secara default MENGALIHKAN ke portal perizinan baru. Setel true hanya untuk
# pemulihan darurat (lalu buka admin/admin_izin.php?legacy=1) dan matikan lagi
# setelah selesai: penulisan lewat modul lama tidak masuk alur V2.
IZIN_LEGACY_ENABLED=false

# ---------------------------------------------------------------------------
# V2 Fase 4 — notifikasi in-app, push, dan WhatsApp opsional.
#
# JANGAN pernah commit nilai sebenarnya. Seluruh secret di bawah dibaca dari
# environment server (cPanel: Setup PHP Environment / file .env di luar akses
# publik) dan TIDAK PERNAH disimpan ke basis data, audit, log, respons API,
# maupun bundle aplikasi mobile.
# ---------------------------------------------------------------------------

# Kunci perlindungan token perangkat push. WAJIB diisi agar registrasi push
# dilayani. Buat dengan: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Mengganti kunci ini membuat seluruh token lama tidak dapat dibuka lagi;
# perangkat akan mendaftar ulang saat aplikasi dibuka berikutnya.
PUSH_TOKEN_KEY=

# Opsional. Hanya diperlukan bila proyek Expo mewajibkan autentikasi pengiriman
# push (Expo access token). Kosongkan bila tidak dipakai.
EXPO_ACCESS_TOKEN=

# Batas waktu panggilan ke layanan push, dalam detik (3-30).
PUSH_TIMEOUT_SECONDS=10

# Jumlah baris outbox yang diproses satu putaran worker (1-100).
NOTIFIKASI_WORKER_BATCH=25

# --- WhatsApp (OPSIONAL, default MATI) -------------------------------------
# Kosong  = tidak ada penyedia; WhatsApp mati dan tidak ada permintaan keluar.
# fake    = adapter uji; memverifikasi kontrak TANPA mengirim pesan nyata.
#           Ditolak sistem ketika APP_ENV=production.
# selain itu = adapter HTTP generik yang netral vendor (lihat variabel di bawah).
WHATSAPP_PROVIDER=

# Perilaku adapter uji: ok | gagal | gagal_permanen | verify_gagal
WHATSAPP_FAKE_MODE=
# Berkas jurnal adapter uji (opsional; nomor tujuan dicatat tersamar).
WHATSAPP_FAKE_JOURNAL=

# Adapter HTTP generik. Endpoint WAJIB HTTPS.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_AUTH_HEADER=
WHATSAPP_AUTH_PREFIX=
WHATSAPP_SENDER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_FIELD_TO=
WHATSAPP_FIELD_TEXT=
WHATSAPP_VERIFY_URL=
WHATSAPP_TIMEOUT_SECONDS=
